{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build && node scripts/strip-media.mjs",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/charlas/:id/slides",
      "destination": "https://valentorassa-media.vercel.app/charlas/:id/slides"
    },
    {
      "source": "/charlas/:id/reel.mp4",
      "destination": "https://valentorassa-media.vercel.app/charlas/:id/reel.mp4"
    },
    {
      "source": "/og-charlas/:file.png",
      "destination": "https://valentorassa-media.vercel.app/og-charlas/:file.png"
    },
    {
      "source": "/p/:path*",
      "destination": "https://valentorassa-preview.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/p/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www\\.valentorassa\\.com" }],
      "destination": "https://valentorassa.com/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!en(?:/|$)).*)",
      "has": [{ "type": "query", "key": "lang", "value": "en" }],
      "destination": "/en/:path*",
      "permanent": true
    },
    {
      "source": "/links",
      "has": [{ "type": "host", "value": "valentorassa\\.com" }],
      "destination": "https://links.vtsecurity.com.ar/",
      "permanent": true
    },
    {
      "source": "/en/links",
      "has": [{ "type": "host", "value": "valentorassa\\.com" }],
      "destination": "https://links.vtsecurity.com.ar/en",
      "permanent": true
    }
  ]
}
