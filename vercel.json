{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build && node scripts/strip-media.mjs",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/charlas/:id/slides",
      "destination": "https://valentorassa-media.vercel.app/charlas/:id/slides"
    },
    {
      "source": "/charlas/:id/reel.mp4",
      "destination": "https://valentorassa-media.vercel.app/charlas/:id/reel.mp4"
    },
    {
      "source": "/og-charlas/:file.png",
      "destination": "https://valentorassa-media.vercel.app/og-charlas/:file.png"
    },
    {
      "source": "/p/:path*",
      "destination": "https://valentorassa-preview.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()"
        }
      ]
    },
    {
      "source": "/((?!p(?:/|$)).*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/((?!p(?:/|$)|experiencia(?:/|$)|charlas/[^/]+/slides(?:\\.html)?$|.*\\.pdf$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-hashes' 'sha256-1jAmyYXcRq6zFldLe/GCgIDJBiOONdXjTLgEFMDnDSM=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://vtsecurity.com.ar https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/(experiencia(?:/.*)?|charlas/[^/]+/slides(?:\\.html)?)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/((?!p(?:/|$)|experiencia(?:/|$)).*\\.pdf)",
      "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }]
    },
    {
      "source": "/(p(?:/.*)?)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/p/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www\\.valentorassa\\.com" }],
      "destination": "https://valentorassa.com/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!en(?:/|$)).*)",
      "has": [{ "type": "query", "key": "lang", "value": "en" }],
      "destination": "/en/:path*",
      "permanent": true
    },
    {
      "source": "/links",
      "has": [{ "type": "host", "value": "valentorassa\\.com" }],
      "destination": "https://links.vtsecurity.com.ar/",
      "permanent": true
    },
    {
      "source": "/en/links",
      "has": [{ "type": "host", "value": "valentorassa\\.com" }],
      "destination": "https://links.vtsecurity.com.ar/en",
      "permanent": true
    }
  ]
}
